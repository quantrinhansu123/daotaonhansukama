# CloudFly Object Storage cho video bài học và video giới thiệu.
# Ba khóa dưới đây chỉ được dùng phía server.
CLOUDFLY_S3_BUCKET=
CLOUDFLY_S3_ACCESS_KEY_ID=
CLOUDFLY_S3_SECRET_ACCESS_KEY=
# CLOUDFLY_S3_ENDPOINT=https://s3.cloudfly.vn
# CLOUDFLY_S3_REGION=hn

# Chỉ cần hostname cũ nếu ảnh/tài liệu hiện có vẫn dùng Bunny Stream CDN.
NEXT_PUBLIC_BUNNY_STREAM_CDN_HOSTNAME=

# Bunny Storage
NEXT_PUBLIC_BUNNY_STORAGE_ZONE=
NEXT_PUBLIC_BUNNY_STORAGE_PASSWORD=
NEXT_PUBLIC_BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
NEXT_PUBLIC_BUNNY_STORAGE_CDN_URL=

# Firebase client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Chỉ dùng cho phương án Firebase Auth cũ, không cần khi dùng Supabase.
NEXT_PUBLIC_FIREBASE_AUTH_ENABLED=false
# Chỉ dùng cho phương án Firebase Auth cũ sau khi đã khóa Firestore.
FIREBASE_AUTH_CUTOVER_READY=false

# Firebase Admin SDK, chỉ dùng phía server. Có thể dùng GOOGLE_APPLICATION_CREDENTIALS
# trên máy local hoặc 3 biến dưới trên môi trường deploy.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Supabase (chỉ có hiệu lực sau khi chuyển mã và dữ liệu)
NEXT_PUBLIC_SUPABASE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Khóa bí mật chỉ dùng trên server; không thêm NEXT_PUBLIC_ vào tên biến.
SUPABASE_SECRET_KEY=
# Chỉ dùng cho script tạo bảng/chuyển dữ liệu; URI từ Connect > Session pooler.
SUPABASE_DB_URL=
