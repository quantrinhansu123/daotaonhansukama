# CloudFly Object Storage cho video bài học và video giới thiệu.
# Ba khóa dưới đây chỉ được dùng phía server.
CLOUDFLY_S3_BUCKET=
CLOUDFLY_S3_ACCESS_KEY_ID=
CLOUDFLY_S3_SECRET_ACCESS_KEY=
# CLOUDFLY_S3_ENDPOINT=https://s3.cloudfly.vn
# CLOUDFLY_S3_REGION=hn

# Chỉ cần hostname cũ nếu ảnh/tài liệu hiện có vẫn dùng Bunny Stream CDN.
NEXT_PUBLIC_BUNNY_STREAM_CDN_HOSTNAME=

# Bunny Storage
NEXT_PUBLIC_BUNNY_STORAGE_ZONE=
NEXT_PUBLIC_BUNNY_STORAGE_PASSWORD=
NEXT_PUBLIC_BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
NEXT_PUBLIC_BUNNY_STORAGE_CDN_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_ENABLED=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Khóa bí mật chỉ dùng trên server; không thêm NEXT_PUBLIC_ vào tên biến.
# Service role key from Supabase (Project Settings → API). Required for admin user create/delete on server.
SUPABASE_SECRET_KEY=
# Optional alias accepted by the app if your host uses this name instead:
# SUPABASE_SERVICE_ROLE_KEY=
# Chỉ dùng cho script tạo bảng/chuyển dữ liệu; URI từ Connect > Session pooler.
SUPABASE_DB_URL=

# Pipeline mới tắt mặc định. Chỉ bật hai biến này trên local sau khi migration
# và video:pipeline:check đạt. Không đặt development trong Vercel production.
# VIDEO_PIPELINE_ENV=development
# NEXT_PUBLIC_VIDEO_PIPELINE_ENABLED=true
VIDEO_WORKER_THREADS=2

# Vùng VIDEO RIÊNG: khóa chỉ ở server; không dùng NEXT_PUBLIC_ cho các khóa này.
BUNNY_VIDEO_STORAGE_ZONE=
BUNNY_VIDEO_STORAGE_KEY=
BUNNY_VIDEO_STORAGE_HOSTNAME=sg.storage.bunnycdn.com
BUNNY_VIDEO_CDN_HOSTNAME=
BUNNY_VIDEO_TOKEN_KEY=
# Chỉ dùng bởi script cấu hình/phục hồi thư viện cũ; không cần cho player/worker.
# BUNNY_ACCOUNT_API_KEY=
# BUNNY_VIDEO_STORAGE_ZONE_ID=
# BUNNY_VIDEO_PULL_ZONE_ID=
